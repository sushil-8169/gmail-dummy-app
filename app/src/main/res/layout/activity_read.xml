<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/ToolbarIcon"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btn_archive"
            style="@style/ToolbarIcon"
            android:layout_marginEnd="8dp"
            android:contentDescription="Archive"
            android:src="@drawable/ic_archive" />

        <ImageView
            android:id="@+id/btn_delete"
            style="@style/ToolbarIcon"
            android:layout_marginEnd="8dp"
            android:contentDescription="Delete"
            android:src="@drawable/ic_delete" />

        <ImageView
            android:id="@+id/btn_mark_unread"
            style="@style/ToolbarIcon"
            android:layout_marginEnd="8dp"
            android:contentDescription="Mark as unread"
            android:src="@drawable/ic_mark_unread" />

        <ImageView
            android:id="@+id/btn_more"
            style="@style/ToolbarIcon"
            android:contentDescription="More options"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Subject with the inline importance marker and label chip, and the star -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/subject"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/on_surface"
                    android:textIsSelectable="true"
                    android:textSize="24sp" />

                <ImageView
                    android:id="@+id/star"
                    style="@style/ToolbarIcon"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="Star" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_read_card"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Sender row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/avatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TableLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:shrinkColumns="0">

                            <TableRow android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/sender"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:fontFamily="sans-serif-medium"
                                    android:singleLine="true"
                                    android:textColor="@color/on_surface"
                                    android:textSize="16sp" />

                                <ImageView
                                    android:id="@+id/verified"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="6dp"
                                    android:contentDescription="Verified sender"
                                    android:src="@drawable/ic_verified"
                                    android:tint="@color/verified"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/date"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="sans-serif"
                                    android:singleLine="true"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="13sp" />
                            </TableRow>
                        </TableLayout>

                        <TextView
                            android:id="@+id/recipient"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:drawableEnd="@drawable/ic_expand_more"
                            android:drawablePadding="4dp"
                            android:drawableTint="@color/on_surface_variant"
                            android:fontFamily="sans-serif"
                            android:gravity="center_vertical"
                            android:singleLine="true"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btn_react"
                        style="@style/ToolbarIcon"
                        android:contentDescription="Add emoji reaction"
                        android:src="@drawable/ic_emoji" />

                    <ImageView
                        android:id="@+id/btn_reply_top"
                        style="@style/ToolbarIcon"
                        android:contentDescription="Reply"
                        android:src="@drawable/ic_reply" />

                    <ImageView
                        android:id="@+id/btn_more_sender"
                        style="@style/ToolbarIcon"
                        android:contentDescription="More options"
                        android:src="@drawable/ic_more_vert" />
                </LinearLayout>

                <!-- Expanded sender details, shown when "to me" is tapped -->
                <TextView
                    android:id="@+id/details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="80dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/on_surface_variant"
                    android:textIsSelectable="true"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoLink="web|email"
                    android:fontFamily="sans-serif"
                    android:lineSpacingMultiplier="1.3"
                    android:paddingStart="24dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="24dp"
                    android:textColor="@color/on_surface"
                    android:textColorLink="@color/primary"
                    android:textIsSelectable="true"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/attachment"
                    android:layout_width="176dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_attachment_card"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:layout_margin="1dp"
                        android:background="@drawable/bg_attachment_preview">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_pdf"
                            android:tint="@color/draft" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_pdf"
                            android:tint="@color/draft" />

                        <TextView
                            android:id="@+id/attachment_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="middle"
                            android:fontFamily="sans-serif-medium"
                            android:singleLine="true"
                            android:textColor="@color/on_surface"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Pinned reply actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/btn_reply"
            style="@style/ReplyButton">

            <ImageView
                style="@style/ReplyIcon"
                android:src="@drawable/ic_reply" />

            <TextView
                style="@style/ReplyText"
                android:text="Reply" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_forward"
            style="@style/ReplyButton"
            android:layout_marginStart="8dp">

            <ImageView
                style="@style/ReplyIcon"
                android:src="@drawable/ic_forward" />

            <TextView
                style="@style/ReplyText"
                android:text="Forward" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_emoji"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_emoji_button"
            android:contentDescription="Add emoji reaction"
            android:padding="12dp"
            android:src="@drawable/ic_emoji"
            android:tint="@color/on_reply" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nav_bar"
        android:orientation="horizontal" />
</LinearLayout>
