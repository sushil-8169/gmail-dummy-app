<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/ToolbarIcon"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btn_archive"
            style="@style/ToolbarIcon"
            android:contentDescription="Archive"
            android:src="@drawable/ic_archive" />

        <ImageView
            android:id="@+id/btn_delete"
            style="@style/ToolbarIcon"
            android:contentDescription="Delete"
            android:src="@drawable/ic_delete" />

        <ImageView
            android:id="@+id/btn_mark_unread"
            style="@style/ToolbarIcon"
            android:contentDescription="Mark as unread"
            android:src="@drawable/ic_mail_outline" />

        <ImageView
            android:id="@+id/btn_more"
            style="@style/ToolbarIcon"
            android:contentDescription="More options"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Subject with the inline label chip, and the star -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/subject"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/on_surface"
                    android:textIsSelectable="true"
                    android:textSize="22sp" />

                <ImageView
                    android:id="@+id/star"
                    style="@style/ToolbarIcon"
                    android:contentDescription="Star" />
            </LinearLayout>

            <!-- Sender row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/sender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/recipient"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_expand_more"
                        android:drawablePadding="2dp"
                        android:drawableTint="@color/on_surface_variant"
                        android:fontFamily="sans-serif"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_reply_top"
                    style="@style/ToolbarIcon"
                    android:contentDescription="Reply"
                    android:src="@drawable/ic_reply" />

                <ImageView
                    android:id="@+id/btn_more_sender"
                    style="@style/ToolbarIcon"
                    android:contentDescription="More options"
                    android:src="@drawable/ic_more_vert" />
            </LinearLayout>

            <!-- Expanded sender details, shown when "to me" is tapped -->
            <TextView
                android:id="@+id/details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="68dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/on_surface_variant"
                android:textIsSelectable="true"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoLink="web|email"
                android:fontFamily="sans-serif"
                android:lineSpacingMultiplier="1.25"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:textColor="@color/on_surface"
                android:textColorLink="@color/primary"
                android:textIsSelectable="true"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/attachment"
                android:layout_width="176dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_attachment_card"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_margin="1dp"
                    android:background="@drawable/bg_attachment_preview">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_pdf"
                        android:tint="#D93025" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_pdf"
                        android:tint="#D93025" />

                    <TextView
                        android:id="@+id/attachment_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="middle"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="32dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/btn_reply"
                    style="@style/ReplyButton"
                    android:drawableStart="@drawable/ic_reply"
                    android:text="Reply" />

                <TextView
                    android:id="@+id/btn_reply_all"
                    style="@style/ReplyButton"
                    android:layout_marginStart="8dp"
                    android:drawableStart="@drawable/ic_reply_all"
                    android:text="Reply all" />

                <TextView
                    android:id="@+id/btn_forward"
                    style="@style/ReplyButton"
                    android:layout_marginStart="8dp"
                    android:drawableStart="@drawable/ic_forward"
                    android:text="Forward" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
