<?xml version="1.0" encoding="utf-8"?>
<!-- Meet's in-call screen: your tile, the call controls, and a "meeting ready" card for new meetings. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/call_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/call_code"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@color/call_text"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/btn_share_call"
                style="@style/ToolbarIcon"
                android:contentDescription="Share joining info"
                android:src="@drawable/ic_share"
                android:tint="@color/call_text" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_call_tile">

            <TextView
                android:id="@+id/call_avatar"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="A"
                android:textColor="#FFFFFF"
                android:textSize="48sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="You"
                android:textColor="@color/call_text"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/call_mic_indicator"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:contentDescription="Microphone off"
                android:padding="6dp"
                android:src="@drawable/ic_mic_off"
                android:tint="@color/call_text"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:paddingTop="16dp"
            android:text="You’re the only one here"
            android:textColor="@color/call_text_variant"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <ImageView
                android:id="@+id/btn_camera"
                style="@style/CallButton" />

            <ImageView
                android:id="@+id/btn_mic"
                style="@style/CallButton" />

            <ImageView
                android:id="@+id/btn_more_call"
                style="@style/CallButton"
                android:contentDescription="More options"
                android:src="@drawable/ic_more_vert" />

            <ImageView
                android:id="@+id/btn_end_call"
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_call_end"
                android:contentDescription="Leave call"
                android:padding="16dp"
                android:src="@drawable/ic_call_end"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ready_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="104dp"
        android:background="@drawable/bg_call_card"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="Your meeting’s ready"
                android:textColor="@color/call_text"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/btn_close_ready"
                style="@style/ToolbarIcon"
                android:contentDescription="Close"
                android:src="@drawable/ic_close"
                android:tint="@color/call_text_variant" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.2"
            android:text="Share this meeting link with others that you want in the meeting"
            android:textColor="@color/call_text_variant"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_call_link"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp">

            <TextView
                android:id="@+id/ready_link"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:textColor="@color/call_text"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btn_copy_ready"
                style="@style/ToolbarIcon"
                android:contentDescription="Copy joining info"
                android:src="@drawable/ic_content_copy"
                android:tint="@color/call_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_share_ready"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_call_accent_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_share"
                android:tint="@color/on_call_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Share invite"
                android:textColor="@color/on_call_accent"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
